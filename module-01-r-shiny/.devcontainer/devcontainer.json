{
  "name": "R and Shiny Development",
  "image": "rocker/shiny-verse:latest",
  "customizations": {
    "vscode": {
      "extensions": [
        "REditorSupport.r",
        "Ikuyadeu.r-lsp"
      ],
      "settings": {
        "r.rterm.linux": "/usr/local/bin/R",
        "r.bracketedPaste": true
      }
    }
  },
  "forwardPorts": [3838],
  "postCreateCommand": "R -e \"install.packages(c('tidyverse', 'shiny', 'shinydashboard'), repos='https://cran.rstudio.com/')\""
}
